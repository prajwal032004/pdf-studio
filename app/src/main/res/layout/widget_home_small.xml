<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg" android:padding="10dp" android:clipToOutline="true"
    android:gravity="center_vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <FrameLayout android:id="@+id/w_profile" android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/wt_violet">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center"
                android:src="@drawable/wi_pdf" android:contentDescription="PDF Studio"/>
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PDF Studio"
                android:textColor="@color/widget_title" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:textStyle="bold"/>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Made by "
                    android:textColor="@color/widget_sub" android:textSize="11sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Prajwal"
                    android:textColor="@color/widget_accent" android:textSize="11sp" android:textStyle="bold"/>
                <TextView android:id="@+id/w_greeting" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="" android:textColor="@color/widget_sub" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
        <LinearLayout android:id="@+id/t_open" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal" android:padding="3dp">
            <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/wt_blue">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center"
                    android:src="@drawable/wi_open" android:contentDescription="Open"/>
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                android:text="Open" android:textColor="@color/widget_label" android:textSize="11sp" android:maxLines="1"
                android:ellipsize="end" android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/t_scan" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal" android:padding="3dp">
            <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/wt_teal">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center"
                    android:src="@drawable/wi_scan" android:contentDescription="Scan"/>
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                android:text="Scan" android:textColor="@color/widget_label" android:textSize="11sp" android:maxLines="1"
                android:ellipsize="end" android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
        <LinearLayout android:id="@+id/t_merge" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal" android:padding="3dp">
            <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/wt_violet">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center"
                    android:src="@drawable/wi_merge" android:contentDescription="Merge"/>
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                android:text="Merge" android:textColor="@color/widget_label" android:textSize="11sp" android:maxLines="1"
                android:ellipsize="end" android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/t_all" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal" android:padding="3dp">
            <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/wt_slate">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center"
                    android:src="@drawable/wi_apps" android:contentDescription="Tools"/>
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                android:text="Tools" android:textColor="@color/widget_label" android:textSize="11sp" android:maxLines="1"
                android:ellipsize="end" android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
