# Copy to keystore.properties (git-ignored) to sign release builds with your own key.
# Create a key: keytool -genkeypair -v -keystore my-upload-key.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
storeFile=my-upload-key.jks
storePassword=your-store-password
keyAlias=upload
keyPassword=your-key-password
